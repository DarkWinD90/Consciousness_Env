	edge [color=black fontname=Arial fontsize=10 penwidth=1.2]
	input [label="External
Input
(10)" shape=parallelogram]
	snn [label="Spiking Neural
Network
(20)"]
	output [label="Aggregate
Output
(30)"]
	record [label="Record Output
at timestep t
(40)"]
	scale [label="Scale by
